# Server-side target for the Next.js /api proxy (set this to the backend origin on Render).
API_PROXY_TARGET=http://localhost:3001

# Fallback API URL for demo mode when NEXT_PUBLIC_USE_API=false.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Read and change live data through the API above.
# Needs the backend running and, for signed-in pages, the authentication task.
NEXT_PUBLIC_USE_API=true
